# Copy to `.env` for local development. Do NOT commit `.env`.
#
# Where the app looks for the Django backend. Anything prefixed EXPO_PUBLIC_ is
# inlined into the JS bundle at build time, so never put secrets here.
#
# Default (omit this file entirely): https://dr-nath.com — the live backend.
#
# To point at a Django dev server on your own machine, use your LAN IP. A phone
# resolves "localhost" to itself, so localhost/127.0.0.1 will not work:
#   EXPO_PUBLIC_API_HOST=http://192.168.1.20:8000
#
# Note: if you do run against a local backend over plain http, Android blocks
# cleartext traffic by default in release builds — use the development profile.
EXPO_PUBLIC_API_HOST=https://dr-nath.com
