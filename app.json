{
  "expo": {
    "name": "Dr. Nath",
    "slug": "dr-nath",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "drnath",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drnath.coaching",
      "infoPlist": {
        "NSCameraUsageDescription": "Dr. Nath uses your camera for live coaching video sessions.",
        "NSMicrophoneUsageDescription": "Dr. Nath uses your microphone for live coaching sessions.",
        "NSPhotoLibraryUsageDescription": "Dr. Nath needs photo access so you can upload a profile picture and share files with your coach."
      }
    },
    "android": {
      "package": "com.drnath.coaching",
      "adaptiveIcon": {
        "backgroundColor": "#1B2B4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1B2B4A"
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": null
      }
    }
  }
}